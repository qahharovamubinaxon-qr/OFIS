/* OFIS dark theme — premium, calm, Windows-11-native feel. */

QWidget { background: #0d1117; color: #e6e9ef; font-family: "Segoe UI", "Arial"; font-size: 14px; }
QMainWindow { background: #0d1117; }
QLabel { background: transparent; }
QToolTip { background: #1a2029; color: #e6e9ef; border: 1px solid #2b3646; border-radius: 6px; padding: 6px 8px; }
QFrame[frameShape="4"] { border: none; background: #1c232e; max-height: 1px; }
QMenu { background: #131a23; border: 1px solid #263041; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background: #1a2942; }

/* ---------- sidebar ---------- */
#sidebar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10151c, stop:1 #0c1016);
           border-right: 1px solid #1c232e; }
#brand { color: #5b93ff; font-size: 22px; font-weight: 800; letter-spacing: 4px;
         padding: 24px 0 18px 0; border-bottom: 1px solid #1c232e; background: transparent; }

#navList { background: transparent; border: none; padding: 12px 10px; outline: 0; }
#navList::item { padding: 11px 14px; margin: 2px 4px; border-radius: 9px; color: #9aa4b4;
                 border-left: 3px solid transparent; }
#navList::item:hover { background: #171e28; color: #e6e9ef; }
#navList::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                          stop:0 #1a2942, stop:1 #16202f);
                          color: #ffffff; border-left: 3px solid #2f6bff; font-weight: 600; }

/* ---------- typography ---------- */
#viewTitle { font-size: 26px; font-weight: 700; color: #f2f4f8; background: transparent; letter-spacing: 0.3px; }
#viewSubtitle { font-size: 14px; color: #8a94a3; margin-top: 6px; background: transparent; }

#sidebarVersion { color: #566172; font-size: 11px; padding: 10px 0 12px 0;
                  border-top: 1px solid #1c232e; background: transparent; }

#refreshButton { background: #16202e; border: 1px solid #26364d; border-radius: 9px;
                 color: #a8b6cc; font-weight: 600; padding: 9px 12px; }
#refreshButton:hover { background: #1c2a3d; border-color: #35507a; color: #dce5f2; }
#refreshButton:pressed { background: #131c28; }

/* ---------- status bar ---------- */
QStatusBar { background: #10151c; color: #8a94a3; border-top: 1px solid #1c232e; }
QStatusBar QLabel { color: #8a94a3; background: transparent; }
QStatusBar::item { border: none; }
#statusReady { color: #3ecf8e; font-weight: 600; }
#statusChip { color: #9aa4b4; background: #171e28; border: 1px solid #263041;
              border-radius: 9px; padding: 2px 10px; margin-right: 8px; }

/* ---------- cards ---------- */
#statCard { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #131a23, stop:1 #10161e);
            border: 1px solid #1e2734; border-radius: 14px; min-width: 150px; }
#statValue { font-size: 30px; font-weight: 800; color: #5b93ff; background: transparent; }
#statLabel { font-size: 12px; color: #8a94a3; background: transparent; }

#card { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141b25, stop:1 #111823);
        border: 1px solid #1f2836; border-radius: 16px; }
#card QLabel { background: transparent; }
#cardTitle { font-size: 15px; font-weight: 700; color: #eef1f6; letter-spacing: 0.2px; }
#cardSubtitle { font-size: 12.5px; color: #7e8a9b; }
#cardNote { font-size: 12px; color: #6f7b8c; }
#primaryButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                 stop:0 #2f7bff, stop:1 #1d5fe8);
                 color: #ffffff; font-weight: 600; border: 1px solid #2f6bff;
                 border-radius: 8px; padding: 7px 20px; }
#primaryButton:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                       stop:0 #4189ff, stop:1 #2a6cf2); }

/* ---------- buttons ---------- */
QPushButton { background: #161d27; border: 1px solid #263041; border-radius: 9px;
              padding: 8px 16px; color: #dfe4ec; }
QPushButton:hover { background: #1d2633; border-color: #33405a; }
QPushButton:pressed { background: #141b24; }
QPushButton:disabled { background: #141922; color: #5d6878; border-color: #1e2734; }

#runButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2f7bff, stop:1 #1d5fe8);
             color: #ffffff; font-weight: 700; padding: 11px 26px; border-radius: 10px;
             border: 1px solid #2f6bff; }
#runButton:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4189ff, stop:1 #2a6cf2); }
#runButton:pressed { background: #1d5fe8; }
#runButton:disabled { background: #232c39; color: #6b7686; border-color: #232c39; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #10161e; border: 1px solid #263041; border-radius: 8px;
    padding: 7px 10px; color: #e6e9ef; selection-background-color: #2f6bff; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #2f6bff; background: #111a26; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: none; border-left: 5px solid transparent; border-right: 5px solid transparent;
                        border-top: 6px solid #8a94a3; margin-right: 8px; }
QComboBox QAbstractItemView { background: #131a23; border: 1px solid #263041; border-radius: 8px;
                              selection-background-color: #1d2735; padding: 4px; outline: 0; }
QDateEdit::drop-down, QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; }

/* ---------- lists / tables ---------- */
QListWidget { background: #10161e; border: 1px solid #1e2734; border-radius: 10px; padding: 4px; outline: 0; }
QListWidget::item { padding: 8px 10px; border-radius: 7px; }
QListWidget::item:hover { background: #171e28; }
QListWidget::item:selected { background: #1a2942; color: #ffffff; }
QTableWidget { background: #10161e; border: 1px solid #1e2734; border-radius: 10px;
               gridline-color: #1c232e; outline: 0; }
QTableWidget::item { padding: 6px; }
QTableWidget::item:selected { background: #1a2942; color: #ffffff; }
QHeaderView::section { background: #131a23; color: #9aa4b4; border: none;
                       border-bottom: 1px solid #263041; padding: 8px; font-weight: 600; }
QTableCornerButton::section { background: #131a23; border: none; }

/* ---------- dialogs ---------- */
QDialog { background: #0f141b; }
QMessageBox { background: #0f141b; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2b3646; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3a4863; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2b3646; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #3a4863; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- drop zones ---------- */
#dropZone { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10161e, stop:1 #0e141b);
            border: 2px dashed #2b3646; border-radius: 16px; }
#dropZone[filled="true"] { border: 2px solid #1d6fff; background: #121c2c; }
#dropZone[hover="true"] { border: 2px solid #4c8dff; background: #152134; }
#dzIcon { font-size: 28px; background: transparent; }
#dzTitle { font-size: 14px; font-weight: 700; color: #e6e9ef; background: transparent; }
#dzHint { font-size: 11px; color: #8a94a3; background: transparent; }
