/* ===========================================================================
   OFIS — «приборная панель»: the instrument panel at night.

   The office chose this look from a head-up display: a black ground, sharp
   corners, hairline frames, and one warm machine colour running through the
   chrome. Everything here follows from three rules.

   ONE — THE GROUND IS BLACK AND THE FRAMES ARE HAIRLINES.
   Surfaces are not raised with fills and radii; they are drawn with a single
   line. Corners are square. A panel is a frame, not a pillow.

   TWO — TWO VOICES, NEVER MIXED.
   @ACCENT@ is the colour of the PAPER the open section prints — патент pink,
   регистрация sage, ДМС red (src/ui/theme.py). It appears on exactly three
   things: the rail beside the open section, the hairline under the screen's
   title, and the RUN button. The orange #FF7A18 is the MACHINE's own voice —
   progress, search, chips, the program talking about itself. The operator can
   always tell which of the two is speaking.

   THREE — NOTHING GLOWS.
   No text shadow, no bloom, no gradient wash. This is read for eight hours a
   day; the look is carried by frames and spacing, not by light.

   ink        #05070A   ground
   panel      #0A0E14   cards, surfaces
   raised     #121A22   hover, chips
   inset      #05070A   inputs, wells (darker than the panel they sit in)
   line       #26384A   frames
   line-soft  #1A2430   dividers inside a frame
   text       #E8EEF2
   muted      #8A9BA8   labels, hints
   faint      #60707E   version, disabled
   machine    #FF7A18   the program's own voice
   =========================================================================== */

QWidget { background: #05070A; color: #E8EEF2;
          font-family: "Segoe UI Variable Text", "Segoe UI", "Inter",
                       "Arial", sans-serif; font-size: 14px; }
QMainWindow { background: #05070A; }
QLabel { background: transparent; }
QToolTip { background: #121A22; color: #E8EEF2; border: 1px solid #26384A;
           border-radius: 0; padding: 8px 12px; }
QFrame[frameShape="4"] { border: none; background: #1A2430; max-height: 1px; }
QMenu { background: #0A0E14; border: 1px solid #26384A; border-radius: 0; padding: 6px; }
QMenu::item { padding: 9px 24px; }
QMenu::item:selected { background: #121A22; }

/* ---------- sidebar: the instrument rail ---------- */
#sidebar { background: #04060A; border-right: 1px solid #16222E; }
#brandMark { background: transparent; border-bottom: 1px solid #16222E; }

#navList { background: transparent; border: none; padding: 10px 8px; outline: 0; }
#navList::item { padding: 10px 13px; margin: 1px 2px; border-radius: 0;
                 color: #A3B6C3; border-left: 2px solid transparent; }
#navList::item:hover { background: #0D141C; color: #E8EEF2; }
#navList::item:selected { background: #0F1821; color: #FFFFFF; font-weight: 600;
                          border-left: 2px solid @ACCENT@; }
/* the group headings — letterspaced, quiet, never mistaken for a row */
#navList::item:disabled { color: #4A5D6C; font-size: 10px; font-weight: 700;
                          letter-spacing: 1.9px; padding: 18px 13px 7px 13px;
                          background: transparent; border-left: 2px solid transparent; }

#sidebarVersion { color: #42525F; font-size: 11px; padding: 12px 0 14px 0;
                  border-top: 1px solid #16222E; background: transparent; }

#refreshButton { background: #0A0E14; border: 1px solid #26384A; border-radius: 0;
                 color: #A3B6C3; font-weight: 600; padding: 10px 14px; }
#refreshButton:hover { background: #121A22; border-color: #FF7A18; color: #FFFFFF; }
#refreshButton:pressed { background: #05070A; }

/* ---------- typography ---------- */
#viewTitle { font-size: 29px; font-weight: 700; color: #FFFFFF;
             background: transparent; letter-spacing: 0.3px;
             padding-bottom: 12px; border-bottom: 2px solid @ACCENT@; }
#viewSubtitle { font-size: 13px; color: #8A9BA8; background: transparent; }
/* the small upper-case label above an input */
#fieldLabel { font-size: 10px; font-weight: 700; letter-spacing: 1.9px;
              color: #FF7A18; background: transparent; }
#viewBadge { color: #FFA052; background: #0A0E14; border: 1px solid #26384A;
             border-radius: 0; padding: 6px 14px; font-size: 12px; font-weight: 700; }

/* ---------- status bar ---------- */
QStatusBar { background: #04060A; color: #8A9BA8; border-top: 1px solid #16222E; }
QStatusBar QLabel { color: #8A9BA8; background: transparent; }
QStatusBar::item { border: none; }
#statusReady { color: #6ECFA3; font-weight: 700; }
#statusChip { color: #A3B6C3; background: #0A0E14; border: 1px solid #26384A;
              border-radius: 0; padding: 3px 12px; margin-right: 8px; }

/* ---------- surfaces: every panel is a frame ---------- */
#statCard { background: #0A0E14; border: 1px solid #26384A; border-radius: 0;
            min-width: 150px; }
#statValue { font-family: "Consolas", "Cascadia Mono", monospace;
             font-size: 28px; font-weight: 700; color: #E8EEF2;
             background: transparent; letter-spacing: 1px; }
#statLabel { font-size: 10px; color: #60707E; background: transparent;
             letter-spacing: 1.8px; }

#card { background: #0A0E14; border: 1px solid #26384A; border-radius: 0; }
#card QLabel { background: transparent; }
#cardTitle { font-size: 15px; font-weight: 700; color: #F2F7FA; letter-spacing: .3px; }
#cardSubtitle { font-size: 12.5px; color: #8A9BA8; }
#cardNote { font-size: 12px; color: #60707E; }

/* a titled block — «ўқилгани» and its kin — reads as an instrument panel */
QGroupBox { background: #0A0E14; border: 1px solid #26384A; border-radius: 0;
            margin-top: 12px; padding: 26px 20px 20px 20px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: padding; subcontrol-position: top left;
                   left: 18px; top: 10px; padding: 0; color: #FF7A18;
                   font-size: 11px; font-weight: 700; letter-spacing: 1.8px;
                   background: transparent; }
QGroupBox QLabel { color: #8A9BA8; }

/* ---------- buttons ---------- */
QPushButton { background: #0D141C; border: 1px solid #26384A; border-radius: 0;
              padding: 10px 18px; color: #CFDEE7; font-weight: 600; }
QPushButton:hover { background: #121A22; border-color: #FF7A18; color: #FFFFFF; }
QPushButton:pressed { background: #05070A; }
QPushButton:disabled { background: #080C11; color: #46586A; border-color: #1A2430; }

/* the one loud thing on the screen, in the colour of what it prints */
#runButton, #primaryButton {
    background: @ACCENT@; color: @ACCENT_INK@; font-weight: 700; font-size: 14.5px;
    padding: 13px 30px; border-radius: 0; border: 1px solid @ACCENT@;
    letter-spacing: 1.1px; }
#runButton:hover, #primaryButton:hover {
    background: @ACCENT_SOFT@; border-color: @ACCENT_SOFT@; }
#runButton:pressed, #primaryButton:pressed { background: @ACCENT@; }
#runButton:disabled, #primaryButton:disabled {
    background: #0D141C; color: #46586A; border-color: #1A2430; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #05070A; border: 1px solid #26384A; border-radius: 0;
    padding: 10px 13px; min-height: 20px; color: #E8EEF2;
    selection-background-color: @ACCENT@; selection-color: @ACCENT_INK@; }
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover,
QTextEdit:hover, QPlainTextEdit:hover { border-color: #3A5062; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QTextEdit:focus,
QPlainTextEdit:focus { border: 1px solid @ACCENT@; background: #070C12; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: #080C11; color: #60707E; border-color: #1A2430; }
/* a date and a count are read back digit by digit */
QDateEdit, QSpinBox { font-family: "Consolas", "Cascadia Mono", monospace;
                      letter-spacing: 0.6px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent;
                        border-right: 4px solid transparent;
                        border-top: 5px solid #FF7A18; margin-right: 10px; }
QComboBox QAbstractItemView { background: #0A0E14; border: 1px solid #26384A;
                              border-radius: 0; selection-background-color: #121A22;
                              padding: 4px; outline: 0; }
QDateEdit::drop-down, QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; }

/* ---------- lists / tables ---------- */
QListWidget { background: #05070A; border: 1px solid #26384A; border-radius: 0;
              padding: 4px; outline: 0; }
QListWidget::item { padding: 9px 11px; border-radius: 0; }
QListWidget::item:hover { background: #0D141C; }
QListWidget::item:selected { background: #121A22; color: #FFFFFF; }
QTableWidget { background: #05070A; border: 1px solid #26384A; border-radius: 0;
               gridline-color: #1A2430; outline: 0; }
QTableWidget::item { padding: 8px; }
QTableWidget::item:selected { background: #121A22; color: #FFFFFF; }
QHeaderView::section { background: #0A0E14; color: #FF7A18; border: none;
                       border-bottom: 1px solid #26384A; padding: 10px;
                       font-size: 10.5px; font-weight: 700; letter-spacing: 1.6px; }
QTableCornerButton::section { background: #0A0E14; border: none; }

#settingsNav { background: #05070A; border: 1px solid #26384A; border-radius: 0;
               padding: 8px; outline: 0; }
#settingsNav::item { padding: 11px 13px; margin: 1px 0; border-radius: 0; color: #A3B6C3; }
#settingsNav::item:hover { background: #0D141C; color: #E8EEF2; }
#settingsNav::item:selected { background: #121A22; color: #FFFFFF; font-weight: 600; }

/* ---------- dialogs ---------- */
QDialog { background: #05070A; }
QMessageBox { background: #05070A; }

/* ---------- scrollbars: thin, square, machine-coloured under the hand ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #26384A; border-radius: 0; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #FF7A18; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #26384A; border-radius: 0; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #FF7A18; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- drop zones: a place to lay a document ---------- */
#dropZone { background: #0A0E14; border: 1px solid #26384A; border-radius: 0; }
#dropZone[hover="true"] { border: 1px solid #FF7A18; background: #120D06; }
#dropZone[filled="true"] { border: 1px solid @ACCENT@; background: #0B1118; }
#dzIcon { font-size: 26px; background: transparent; }
#dzTitle { font-size: 13px; font-weight: 700; color: #E8EEF2; background: transparent;
           letter-spacing: .4px; }
#dzHint { font-size: 11px; color: #8A9BA8; background: transparent; }

/* ---------- progress, choices, tabs ---------- */
QProgressBar { background: #05070A; border: 1px solid #26384A; border-radius: 0;
               height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #FF7A18; border-radius: 0; }

QCheckBox, QRadioButton { spacing: 9px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px;
    border: 1px solid #3A5062; border-radius: 0; background: #05070A; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #FF7A18; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @ACCENT@; border-color: @ACCENT@; }

QTabWidget::pane { border: 1px solid #26384A; border-radius: 0; top: -1px; }
QTabBar::tab { background: transparent; color: #8A9BA8; padding: 10px 18px;
               border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:selected { color: #FFFFFF; border-bottom: 2px solid @ACCENT@; }
QTabBar::tab:hover { color: #E8EEF2; }

/* ---------- the screens hang in a scroll host; it owns no colour --------- */
#screenScroll, #screenScroll > QWidget > QWidget { background: transparent; }

/* ---------- home screen ----------
   The cards paint themselves (src/ui/widgets/section_card.py) — the sheet
   only keeps the surfaces they sit on out of their way. */
#homeScroll, #homeScroll > QWidget > QWidget { background: transparent; }
#homeRecent { background: transparent; border: none; padding: 0; }
#homeRecent::item { padding: 3px 2px; color: #8A9BA8; border-radius: 0; }
#homeRecent::item:hover { background: #121A22; color: #E8EEF2; }
#homeRecent::item:selected { background: #121A22; color: #FFFFFF; }

/* ---------- the progress ring's two lines ---------- */
#runProgressText { font-size: 13px; font-weight: 600; color: #E8EEF2;
                   background: transparent; }
#runProgressStep { font-size: 11.5px; color: #8A9BA8; background: transparent; }
