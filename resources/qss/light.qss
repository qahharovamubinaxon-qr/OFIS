/* ===========================================================================
   OFIS — the same instrument panel, by daylight.

   Not the night sheet inverted. Two things change on their own account:

   * the machine's orange darkens to #B4530A — a bright orange on white is a
     smear the eye cannot settle on;
   * the paper colours come from the LIGHT table in src/ui/theme.py, which is
     the document's INK rather than its stock: a pastel on a white screen is a
     smudge, and the eye is looking for the printed line.

   Everything else is the night sheet's language: square corners, hairline
   frames, two voices (@ACCENT@ is the paper, #B4530A is the machine), and
   nothing glowing.

   paper      #EEF2F5   ground
   panel      #FFFFFF   cards, surfaces
   raised     #E7EEF2   hover
   inset      #F7FAFB   inputs
   line       #C9D6DD   frames
   line-soft  #DCE4E9   dividers
   text       #10212B
   muted      #4E6573   labels
   faint      #6B8291   version, disabled
   machine    #B4530A   the program's own voice
   =========================================================================== */

QWidget { background: #EEF2F5; color: #10212B;
          font-family: "Segoe UI Variable Text", "Segoe UI", "Inter",
                       "Arial", sans-serif; font-size: 14px; }
QMainWindow { background: #EEF2F5; }
QLabel { background: transparent; }
QToolTip { background: #FFFFFF; color: #10212B; border: 1px solid #C9D6DD;
           border-radius: 0; padding: 8px 12px; }
QFrame[frameShape="4"] { border: none; background: #DCE4E9; max-height: 1px; }
QMenu { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0; padding: 6px; }
QMenu::item { padding: 9px 24px; }
QMenu::item:selected { background: #E7EEF2; }

/* ---------- sidebar ---------- */
#sidebar { background: #FFFFFF; border-right: 1px solid #D8E1E7; }
#brandMark { background: transparent; border-bottom: 1px solid #E2E9ED; }

#navList { background: transparent; border: none; padding: 10px 8px; outline: 0; }
#navList::item { padding: 10px 13px; margin: 1px 2px; border-radius: 0;
                 color: #3C5261; border-left: 2px solid transparent; }
#navList::item:hover { background: #EDF3F6; color: #10212B; }
#navList::item:selected { background: #E7EEF2; color: #10212B; font-weight: 600;
                          border-left: 2px solid @ACCENT@; }
#navList::item:disabled { color: #7C919E; font-size: 10px; font-weight: 700;
                          letter-spacing: 1.9px; padding: 18px 13px 7px 13px;
                          background: transparent; border-left: 2px solid transparent; }

#sidebarVersion { color: #7C919E; font-size: 11px; padding: 12px 0 14px 0;
                  border-top: 1px solid #E2E9ED; background: transparent; }

#refreshButton { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
                 color: #35505F; font-weight: 600; padding: 10px 14px; }
#refreshButton:hover { background: #F4F8FA; border-color: #B4530A; color: #10212B; }
#refreshButton:pressed { background: #E7EEF2; }

/* ---------- typography ---------- */
#viewTitle { font-size: 29px; font-weight: 700; color: #0B1922;
             background: transparent; letter-spacing: 0.3px;
             padding-bottom: 12px; border-bottom: 2px solid @ACCENT@; }
#viewSubtitle { font-size: 13px; color: #4E6573; background: transparent; }
#fieldLabel { font-size: 10px; font-weight: 700; letter-spacing: 1.9px;
              color: #B4530A; background: transparent; }
#viewBadge { color: #8E420A; background: #FFFFFF; border: 1px solid #C9D6DD;
             border-radius: 0; padding: 6px 14px; font-size: 12px; font-weight: 700; }

/* ---------- status bar ---------- */
QStatusBar { background: #FFFFFF; color: #4E6573; border-top: 1px solid #D8E1E7; }
QStatusBar QLabel { color: #4E6573; background: transparent; }
QStatusBar::item { border: none; }
#statusReady { color: #2F6B52; font-weight: 700; }
#statusChip { color: #4E6573; background: #FFFFFF; border: 1px solid #C9D6DD;
              border-radius: 0; padding: 3px 12px; margin-right: 8px; }

/* ---------- surfaces ---------- */
#statCard { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
            min-width: 150px; }
#statValue { font-family: "Consolas", "Cascadia Mono", monospace;
             font-size: 28px; font-weight: 700; color: #10212B;
             background: transparent; letter-spacing: 1px; }
#statLabel { font-size: 10px; color: #6B8291; background: transparent;
             letter-spacing: 1.8px; }

#card { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0; }
#card QLabel { background: transparent; }
#cardTitle { font-size: 15px; font-weight: 700; color: #0B1922; letter-spacing: .3px; }
#cardSubtitle { font-size: 12.5px; color: #4E6573; }
#cardNote { font-size: 12px; color: #6B8291; }

QGroupBox { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
            margin-top: 12px; padding: 26px 20px 20px 20px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: padding; subcontrol-position: top left;
                   left: 18px; top: 10px; padding: 0; color: #B4530A;
                   font-size: 11px; font-weight: 700; letter-spacing: 1.8px;
                   background: transparent; }
QGroupBox QLabel { color: #4E6573; }

/* ---------- buttons ---------- */
QPushButton { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
              padding: 10px 18px; color: #24404E; font-weight: 600; }
QPushButton:hover { background: #F4F8FA; border-color: #B4530A; color: #10212B; }
QPushButton:pressed { background: #E7EEF2; }
QPushButton:disabled { background: #F1F4F6; color: #9AAAB5; border-color: #DCE4E9; }

#runButton, #primaryButton {
    background: @ACCENT@; color: @ACCENT_INK@; font-weight: 700; font-size: 14.5px;
    padding: 13px 30px; border-radius: 0; border: 1px solid @ACCENT@;
    letter-spacing: 1.1px; }
#runButton:hover, #primaryButton:hover {
    background: @ACCENT_SOFT@; border-color: @ACCENT_SOFT@; }
#runButton:pressed, #primaryButton:pressed { background: @ACCENT@; }
#runButton:disabled, #primaryButton:disabled {
    background: #F1F4F6; color: #9AAAB5; border-color: #DCE4E9; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #F7FAFB; border: 1px solid #C9D6DD; border-radius: 0;
    padding: 10px 13px; min-height: 20px; color: #10212B;
    selection-background-color: @ACCENT@; selection-color: @ACCENT_INK@; }
QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover,
QTextEdit:hover, QPlainTextEdit:hover { border-color: #9FB3BF; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QTextEdit:focus,
QPlainTextEdit:focus { border: 1px solid @ACCENT@; background: #FFFFFF; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: #F1F4F6; color: #9AAAB5; border-color: #DCE4E9; }
QDateEdit, QSpinBox { font-family: "Consolas", "Cascadia Mono", monospace;
                      letter-spacing: 0.6px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent;
                        border-right: 4px solid transparent;
                        border-top: 5px solid #B4530A; margin-right: 10px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #C9D6DD;
                              border-radius: 0; selection-background-color: #E7EEF2;
                              padding: 4px; outline: 0; }
QDateEdit::drop-down, QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; }

/* ---------- lists / tables ---------- */
QListWidget { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
              padding: 4px; outline: 0; }
QListWidget::item { padding: 9px 11px; border-radius: 0; }
QListWidget::item:hover { background: #EDF3F6; }
QListWidget::item:selected { background: #E7EEF2; color: #10212B; }
QTableWidget { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
               gridline-color: #DCE4E9; outline: 0; }
QTableWidget::item { padding: 8px; }
QTableWidget::item:selected { background: #E7EEF2; color: #10212B; }
QHeaderView::section { background: #F4F8FA; color: #8E420A; border: none;
                       border-bottom: 1px solid #C9D6DD; padding: 10px;
                       font-size: 10.5px; font-weight: 700; letter-spacing: 1.6px; }
QTableCornerButton::section { background: #F4F8FA; border: none; }

#settingsNav { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0;
               padding: 8px; outline: 0; }
#settingsNav::item { padding: 11px 13px; margin: 1px 0; border-radius: 0; color: #3C5261; }
#settingsNav::item:hover { background: #EDF3F6; color: #10212B; }
#settingsNav::item:selected { background: #E7EEF2; color: #10212B; font-weight: 600; }

/* ---------- dialogs ---------- */
QDialog { background: #EEF2F5; }
QMessageBox { background: #EEF2F5; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #C3D0D8; border-radius: 0; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #B4530A; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C3D0D8; border-radius: 0; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #B4530A; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- drop zones ---------- */
#dropZone { background: #FFFFFF; border: 1px solid #C9D6DD; border-radius: 0; }
#dropZone[hover="true"] { border: 1px solid #B4530A; background: #FDF3E9; }
#dropZone[filled="true"] { border: 1px solid @ACCENT@; background: #F7FAFB; }
#dzIcon { font-size: 26px; background: transparent; }
#dzTitle { font-size: 13px; font-weight: 700; color: #10212B; background: transparent;
           letter-spacing: .4px; }
#dzHint { font-size: 11px; color: #4E6573; background: transparent; }

/* ---------- progress, choices, tabs ---------- */
QProgressBar { background: #F1F4F6; border: 1px solid #C9D6DD; border-radius: 0;
               height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #B4530A; border-radius: 0; }

QCheckBox, QRadioButton { spacing: 9px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px;
    border: 1px solid #9FB3BF; border-radius: 0; background: #FFFFFF; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #B4530A; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @ACCENT@; border-color: @ACCENT@; }

QTabWidget::pane { border: 1px solid #C9D6DD; border-radius: 0; top: -1px; }
QTabBar::tab { background: transparent; color: #4E6573; padding: 10px 18px;
               border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:selected { color: #10212B; border-bottom: 2px solid @ACCENT@; }
QTabBar::tab:hover { color: #10212B; }

/* ---------- the screens hang in a scroll host ---------- */
#screenScroll, #screenScroll > QWidget > QWidget { background: transparent; }

/* ---------- home screen ---------- */
#homeScroll, #homeScroll > QWidget > QWidget { background: transparent; }
#homeRecent { background: transparent; border: none; padding: 0; }
#homeRecent::item { padding: 3px 2px; color: #4E6573; border-radius: 0; }
#homeRecent::item:hover { background: #E7EEF2; color: #10212B; }
#homeRecent::item:selected { background: #E7EEF2; color: #10212B; }

/* ---------- the progress ring's two lines ---------- */
#runProgressText { font-size: 13px; font-weight: 600; color: #10212B;
                   background: transparent; }
#runProgressStep { font-size: 11.5px; color: #4E6573; background: transparent; }
