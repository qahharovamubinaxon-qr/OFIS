/* ===========================================================================
   OFIS — «дневная смена»: the same press, by daylight.

   The dark theme's rule holds here: the colour on screen is the colour of the
   paper this section prints on, and it appears in three places only — the rail
   beside the open section, the hairline under the title, and the RUN button.

   The ground is document stock, a warm grey-cream rather than white, so a form
   on screen reads the way a form reads on the desk. Panels are the lighter,
   whiter sheet laid on top of it.

   @ACCENT@ / @ACCENT_SOFT@ / @ACCENT_INK@ come from src/ui/theme.py.

   stock      #EDEBE6   ground
   sheet      #F8F7F4   panels, cards
   white      #FFFFFF   inputs
   line       #D9D5CC   borders
   ink        #1B1A18   text
   muted      #6E6A62   labels, hints
   faint      #97928A   version, disabled
   =========================================================================== */

QWidget { background: #EDEBE6; color: #1B1A18;
          font-family: "Segoe UI", "Arial"; font-size: 14px; }
QMainWindow { background: #EDEBE6; }
QLabel { background: transparent; }
QToolTip { background: #1B1A18; color: #F8F7F4; border: 1px solid #1B1A18;
           border-radius: 8px; padding: 7px 10px; }
QFrame[frameShape="4"] { border: none; background: #DFDBD2; max-height: 1px; }
QMenu { background: #FFFFFF; border: 1px solid #D9D5CC; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 8px 22px; border-radius: 7px; }
QMenu::item:selected { background: #EDEBE6; }

/* ---------- sidebar ---------- */
#sidebar { background: #F8F7F4; border-right: 1px solid #DFDBD2; }
/* the mark paints itself (src/ui/widgets/brand_mark.py) */
#brandMark { background: transparent; border-bottom: 1px solid #DFDBD2; }

#navList { background: transparent; border: none; padding: 10px 8px; outline: 0; }
#navList::item { padding: 9px 12px; margin: 1px 4px; border-radius: 8px;
                 color: #56524B; border-left: 3px solid transparent; }
#navList::item:hover { background: #E7E4DD; color: #1B1A18; }
#navList::item:selected { background: #E4E0D7; color: #14130F; font-weight: 600;
                          border-left: 3px solid @ACCENT@; }
#navList::item:disabled { color: #97928A; font-size: 10px; font-weight: 700;
                          letter-spacing: 1.6px; padding: 16px 12px 6px 12px;
                          background: transparent; border-left: 3px solid transparent; }

#sidebarVersion { color: #A29D94; font-size: 11px; padding: 12px 0 14px 0;
                  border-top: 1px solid #DFDBD2; background: transparent; }

#refreshButton { background: transparent; border: 1px solid #D3CFC6; border-radius: 8px;
                 color: #56524B; font-weight: 500; padding: 9px 12px; }
#refreshButton:hover { background: #E7E4DD; border-color: #BEB9AE; color: #1B1A18; }
#refreshButton:pressed { background: #DFDBD2; }

/* ---------- typography ---------- */
#viewTitle { font-size: 30px; font-weight: 600; color: #14130F;
             background: transparent; letter-spacing: -0.2px;
             padding-bottom: 10px; border-bottom: 2px solid @ACCENT@; }
#viewSubtitle { font-size: 13px; color: #6E6A62; margin-top: 8px; background: transparent; }

/* ---------- status bar ---------- */
QStatusBar { background: #F8F7F4; color: #6E6A62; border-top: 1px solid #DFDBD2; }
QStatusBar QLabel { color: #6E6A62; background: transparent; }
QStatusBar::item { border: none; }
#statusReady { color: #3F7D5F; font-weight: 600; }
#statusChip { color: #56524B; background: #E7E4DD; border: 1px solid #D9D5CC;
              border-radius: 9px; padding: 2px 10px; margin-right: 8px; }

/* ---------- cards ---------- */
#statCard { background: #F8F7F4; border: 1px solid #DFDBD2; border-radius: 12px;
            min-width: 150px; }
#statValue { font-family: "Cascadia Mono", "Consolas", monospace;
             font-size: 30px; font-weight: 600; color: @ACCENT@;
             background: transparent; }
#statLabel { font-size: 11px; color: #6E6A62; background: transparent;
             letter-spacing: 0.8px; }

#card { background: #F8F7F4; border: 1px solid #DFDBD2; border-radius: 14px; }
#card QLabel { background: transparent; }
#cardTitle { font-size: 15px; font-weight: 600; color: #1B1A18; }
#cardSubtitle { font-size: 12.5px; color: #6E6A62; }
#cardNote { font-size: 12px; color: #8A857C; }

/* ---------- buttons ---------- */
QPushButton { background: #FFFFFF; border: 1px solid #D3CFC6; border-radius: 8px;
              padding: 8px 16px; color: #33302B; }
QPushButton:hover { background: #F3F1EC; border-color: #BEB9AE; color: #14130F; }
QPushButton:pressed { background: #E7E4DD; }
QPushButton:disabled { background: #EDEBE6; color: #A29D94; border-color: #E1DDD5; }

#runButton, #primaryButton {
    background: @ACCENT@; color: @ACCENT_INK@; font-weight: 600;
    padding: 11px 26px; border-radius: 9px; border: 1px solid @ACCENT@; }
#runButton:hover, #primaryButton:hover {
    background: @ACCENT_SOFT@; border-color: @ACCENT_SOFT@; }
#runButton:pressed, #primaryButton:pressed { background: @ACCENT@; }
#runButton:disabled, #primaryButton:disabled {
    background: #E1DDD5; color: #A29D94; border-color: #E1DDD5; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #FFFFFF; border: 1px solid #D3CFC6; border-radius: 8px;
    padding: 8px 11px; color: #1B1A18; selection-background-color: @ACCENT@;
    selection-color: @ACCENT_INK@; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QTextEdit:focus,
QPlainTextEdit:focus { border: 1px solid @ACCENT@; background: #FFFFFF; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: #EDEBE6; color: #A29D94; border-color: #E1DDD5; }
QDateEdit, QSpinBox { font-family: "Cascadia Mono", "Consolas", monospace;
                      letter-spacing: 0.4px; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent;
                        border-right: 4px solid transparent;
                        border-top: 5px solid #6E6A62; margin-right: 9px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #D9D5CC;
                              border-radius: 8px; selection-background-color: #EDEBE6;
                              padding: 4px; outline: 0; }
QDateEdit::drop-down, QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; }

/* ---------- lists / tables ---------- */
QListWidget { background: #FFFFFF; border: 1px solid #DFDBD2; border-radius: 10px;
              padding: 4px; outline: 0; }
QListWidget::item { padding: 8px 10px; border-radius: 7px; }
QListWidget::item:hover { background: #F3F1EC; }
QListWidget::item:selected { background: #E4E0D7; color: #14130F; }
QTableWidget { background: #FFFFFF; border: 1px solid #DFDBD2; border-radius: 10px;
               gridline-color: #E7E4DD; outline: 0; }
QTableWidget::item { padding: 7px; }
QTableWidget::item:selected { background: #E4E0D7; color: #14130F; }
QHeaderView::section { background: #F3F1EC; color: #6E6A62; border: none;
                       border-bottom: 1px solid #D9D5CC; padding: 9px;
                       font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
QTableCornerButton::section { background: #F3F1EC; border: none; }

#settingsNav { background: #FFFFFF; border: 1px solid #DFDBD2; border-radius: 10px;
               padding: 8px; outline: 0; }
#settingsNav::item { padding: 10px 12px; margin: 2px 0; border-radius: 8px; color: #56524B; }
#settingsNav::item:hover { background: #F3F1EC; color: #1B1A18; }
#settingsNav::item:selected { background: #E4E0D7; color: #14130F; font-weight: 600; }

/* ---------- dialogs ---------- */
QDialog { background: #EDEBE6; }
QMessageBox { background: #EDEBE6; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #CFCAC0; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #B6B0A4; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #CFCAC0; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #B6B0A4; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- drop zones ---------- */
#dropZone { background: #F8F7F4; border: 1px solid #D3CFC6; border-radius: 12px; }
#dropZone[hover="true"] { border: 1px solid @ACCENT@; background: #FFFFFF; }
#dropZone[filled="true"] { border: 1px solid @ACCENT@; background: #FFFFFF; }
#dzIcon { font-size: 26px; background: transparent; }
#dzTitle { font-size: 13.5px; font-weight: 600; color: #1B1A18; background: transparent; }
#dzHint { font-size: 11px; color: #6E6A62; background: transparent; }

/* ---------- progress, choices, tabs ---------- */
QProgressBar { background: #E7E4DD; border: 1px solid #D9D5CC; border-radius: 7px;
               height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background: @ACCENT@; border-radius: 6px; }

QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px;
    border: 1px solid #BEB9AE; border-radius: 4px; background: #FFFFFF; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @ACCENT@; border-color: @ACCENT@; }

QTabWidget::pane { border: 1px solid #DFDBD2; border-radius: 10px; top: -1px; }
QTabBar::tab { background: transparent; color: #6E6A62; padding: 9px 16px;
               border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #14130F; border-bottom: 2px solid @ACCENT@; }
QTabBar::tab:hover { color: #1B1A18; }
